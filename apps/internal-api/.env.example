# Internal API Environment Variables
# Copy this file to .env and update the values

# Application Environment (dev, stg, prod)
APP_ENV=dev

# Firebase Configuration
FIREBASE_DATABASE_URL=https://your-project-dev.firebaseio.com
FIREBASE_PROJECT_ID=your-project-dev

# Secrets (Configure these in Google Cloud Secret Manager)
ENCRYPTION_KEY=your-encryption-key-here
MOCK_API_PROJECT_SECRET=your-mock-api-secret-here

# Server Configuration
PORT=4001
